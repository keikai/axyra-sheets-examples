<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.keikai.axyra</groupId>
    <artifactId>axyra-sheets-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Axyra Sheets Documentation Examples</name>
    <description>Runnable Java examples for the Axyra Sheets documentation.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <axyra.version>1.0.0-Beta.FL.20261013-Eval</axyra.version>
        <junit.version>5.10.2</junit.version>
    </properties>

    <repositories>
        <repository>
            <id>keikai-eval</id>
            <url>https://mavensync.zkoss.org/eval</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.keikai</groupId>
            <artifactId>axyra-sheets</artifactId>
            <version>${axyra.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <!-- the version Axyra Sheets ${axyra.version} depends on -->
            <version>2.22.3</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- One JVM per test class: the evaluation build allows 100 opens,
                         saves and renders per process, which the feature demos
                         together exceed. -->
                    <reuseForks>false</reuseForks>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>io.keikai.axyra.examples.ExampleRunner</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
